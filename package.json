{
  "name": "ping",
  "version": "1.0.0",
  "description": "Real-time anonymous 1-on-1 chat app (Ping)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node src/server.js",
    "build": "echo 'Build complete'",
    "start": "node src/server.js",
    "preview": "node src/server.js",
    "clean": "rm -rf dist",
    "lint": "node -c src/server.js src/config.js src/config/firebase.js src/services/dbService.js src/state/redisStore.js src/state/store.js src/state/reports.js src/services/matchmaking.js src/services/sessionManager.js src/socket/registerSocketHandlers.js public/admin.js public/app.js",
    "smoke": "node scripts/smoke-test.js",
    "test:reports": "node scripts/test-anonymous-reporting.js",
    "train:model": "node scripts/train_and_update_model.js",
    "export:dataset": "node scripts/export_reports_dataset.js",
    "test:moderation": "node scripts/test-conversational-moderation.js",
    "test:redis": "node scripts/test-redis-integration.js",
    "test:firestore": "node scripts/test-firestore-integration.js",
    "test:dm": "node scripts/test-friend-dm-routing.js",
    "test:slur": "node scripts/test-slur-3strike-policy.js && node scripts/test-socket-3strike-flow.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "geoip-lite": "^2.0.3",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
